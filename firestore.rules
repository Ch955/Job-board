rules_version = '2';
// Job Radar: each signed-in user reaches only their own documents.
// Secrets, resumes, push subscriptions, OAuth states and the job pool are
// server-only (the API uses a service account, which bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The app's synced state. The owner reads and writes it; size and shape are checked.
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['state', 'email', 'updated'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000
        && (!('email' in request.resource.data) || request.resource.data.email in ['', request.auth.token.email]);
      allow delete: if owner(uid);
    }

    // Written only by the API (validated there); the owner can read.
    match /profiles/{uid} { allow read: if owner(uid); allow write: if false; }
    match /matches/{uid}  { allow read: if owner(uid); allow write: if false; }
    match /gmail/{uid}    { allow read: if owner(uid); allow write: if false; }

    // Everything else (secrets, resumes, resume_chunks, push, oauth_states, pool): no client access.
    match /{document=**} { allow read, write: if false; }
  }
}
