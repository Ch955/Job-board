# Job Radar API settings. Copy the names into your host's secret settings.
# Never commit real values. Generate APP_ENCRYPTION_KEY with: python -m jobradar.backend new-key

FIREBASE_PROJECT_ID=your-firebase-project-id
# Service account JSON (Firestore + Auth admin), on one line. Not needed on Cloud Run with its own identity.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# 32 random bytes, base64url. Losing it makes stored Gmail tokens and resumes unreadable: back it up privately.
APP_ENCRYPTION_KEY=

# Google OAuth "Web application" client for Gmail (separate from Firebase sign-in)
GMAIL_WEB_CLIENT_ID=
GMAIL_WEB_CLIENT_SECRET=

# Public URLs (https)
API_URL=https://jobradar-api.onrender.com
APP_URL=https://jobradar.pages.dev
# Comma separated. Add https://localhost for the Android app (Capacitor).
ALLOWED_ORIGINS=https://jobradar.pages.dev,https://localhost

# Shared secret for POST /internal/run (only if a scheduler calls the API instead of GitHub Actions)
CRON_SECRET=

# Web push (python -m jobradar push-keys prints a pair)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Android deep link scheme for the Gmail return (matches android/ config)
ANDROID_SCHEME=app.jobradar
