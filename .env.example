# Copy to .env for local runs. NEVER commit .env. In GitHub these go in Secrets.
# Adzuna: https://developer.adzuna.com/  (free)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about  (free)
JOOBLE_API_KEY=
VAPID_PRIVATE_KEY=
# From the app menu. Several devices: a JSON array [ {...}, {...} ] on one line
WEBPUSH_SUBSCRIPTIONS=
# Gmail drafts: from `python -m jobradar gmail-auth --client-file client_secret.json`
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# From `python -m jobradar encrypt-resume your_resume.pdf`
RESUME_KEY=
# Optional extra signature lines, e.g. Phone: +91-XXXXXXXXXX  (use \n for new lines)
EMAIL_SIGNATURE=
